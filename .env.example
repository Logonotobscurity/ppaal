# ============================================
# SUPABASE (PostgreSQL + Auth + Realtime)
# ============================================
# Get these from: https://app.supabase.com → Settings → API

# Public URL (safe for browser)
VITE_SUPABASE_URL=https://wbxsxwgopveolzlckqun.supabase.co

# Anonymous key (public, safe for browser)
VITE_SUPABASE_ANON_KEY=sb_publishable_SO3F4kM0Ca8RvyKBqs0LoQ_Ud9L3svu

# Service role key (SECRET - Backend/CLI only)
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_SO3F4kM0Ca8RvyKBqs0LoQ_Ud9L3svu

# Project reference (for Supabase CLI)
SUPABASE_PROJECT_REF=https://wbxsxwgopveolzlckqun.supabase.co

# Database connection string (optional, for direct psql access)
DATABASE_URL=postgresql:postgresql://postgres:Logors1!9.com@db.wbxsxwgopveolzlckqun.supabase.co:5432/postgres


# ============================================
# SAHARA STT (Code-Switch Speech Recognition)
# ============================================
# Get from: https://sahara.ai/docs (competition project)

VITE_SAHARA_API_KEY=sk_test_...
SAHARA_API_URL=https://api.sahara.ai/v1

# WebSocket endpoint for streaming (if different from HTTP)
SAHARA_WS_URL=wss://api.sahara.ai/v1/stream


# ============================================
# LLM PROVIDERS (Meaning Engine)
# ============================================

# Primary: Claude 3.5 Sonnet
ANTHROPIC_API_KEY=sk-ant-...

# Fallback: Gemini 1.5 Flash
GOOGLE_API_KEY=AIzaSy...
GOOGLE_PROJECT_ID=your-gcp-project

# Local: Ollama (optional, for offline fallback)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b


# ============================================
# EMBEDDINGS & VECTOR DATABASE
# ============================================

# multilingual-e5-base (HuggingFace)
HF_API_KEY=hf_...
EMBEDDING_MODEL=intfloat/multilingual-e5-base


# ============================================
# TTS (Text-to-Speech)
# ============================================

# Coqui TTS (local, no key needed)
VITE_TTS_PROVIDER=coqui
COQUI_MODEL=glow-tts

# Alternative: Web Speech API (browser built-in, no key)
# VITE_TTS_PROVIDER=web-speech


# ============================================
# JOB QUEUE & SCHEDULER
# ============================================

# pg-boss uses Supabase PostgreSQL natively (no extra config needed)
# But you can set explicit connection if needed
PG_BOSS_SCHEMA=pgboss


# ============================================
# FRONTEND (Vite)
# ============================================

VITE_APP_NAME=PAL
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000


# ============================================
# BACKEND (FastAPI WebSocket proxy - if used)
# ============================================

BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info


# ============================================
# COMMUNICATIONS (WhatsApp, SMS, Email)
# ============================================

# Twilio (SMS + WhatsApp)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=SG....


# ============================================
# MONITORING & ANALYTICS
# ============================================

# Sentry (Error Tracking)
SENTRY_DSN=https://key@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# PostHog (Analytics - optional)
POSTHOG_API_KEY=phc_...
POSTHOG_API_URL=https://us.posthog.com


# ============================================
# SECURITY & DEPLOYMENT
# ============================================

# JWT Secret (for local dev only - Supabase manages this in cloud)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Environment mode
NODE_ENV=development

# Timezone for cron jobs (Africa/Lagos = WAT)
TZ=Africa/Lagos


# ============================================
# DEVELOPMENT / LOCAL SUPABASE
# ============================================
